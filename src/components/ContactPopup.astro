---
// ContactPopup.astro
---
<div id="contact-popup-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden items-center justify-center opacity-0 transition-opacity duration-300">
  <div class="bg-white rounded-3xl shadow-2xl p-6 md:p-8 max-w-sm w-full mx-4 transform scale-95 transition-transform duration-300" id="contact-popup-box">
    
    <div class="flex justify-between items-center mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-800">Contact Us</h3>
      </div>
      <button id="close-popup-btn" class="text-gray-400 hover:text-red-500 bg-gray-50 hover:bg-red-50 p-2 rounded-full transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <p class="text-slate-500 text-sm mb-6">Have a project in mind? Reach out to us directly through any of the channels below.</p>

    <div class="space-y-3">
      <!-- Call -->
      <a href="tel:+919148822750" class="flex items-center gap-4 p-4 rounded-2xl bg-orange-50 hover:bg-orange-100 hover:shadow-md transition-all duration-300 group border border-orange-100">
        <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform shadow-sm shadow-orange-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        </div>
        <div>
          <p class="text-[10px] text-orange-600 font-bold uppercase tracking-wider">Call Now</p>
          <p class="text-slate-800 font-bold">+91 91488 22750</p>
        </div>
      </a>

      <!-- Email -->
      <a href="mailto:office@tsbconstructions.com" class="flex items-center gap-4 p-4 rounded-2xl bg-blue-50 hover:bg-blue-100 hover:shadow-md transition-all duration-300 group border border-blue-100">
        <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform shadow-sm shadow-blue-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <div class="overflow-hidden">
          <p class="text-[10px] text-blue-600 font-bold uppercase tracking-wider">Email Us</p>
          <p class="text-slate-800 font-bold truncate">office@tsbconstructions.com</p>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Determine if popup should be shown
    // We can use sessionStorage so it only shows once per tab session
    const hasSeenPopup = sessionStorage.getItem('tsbContactPopupShown');
    
    if (!hasSeenPopup) {
      const overlay = document.getElementById('contact-popup-overlay');
      const box = document.getElementById('contact-popup-box');
      const closeBtn = document.getElementById('close-popup-btn');

      if (overlay && box) {
        // Show after 2 seconds
        setTimeout(() => {
          overlay.classList.remove('hidden');
          overlay.classList.add('flex');
          
          // Trigger animations
          setTimeout(() => {
            overlay.classList.remove('opacity-0');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
          }, 10);
        }, 2000);

        const closePopup = () => {
          overlay.classList.add('opacity-0');
          box.classList.remove('scale-100');
          box.classList.add('scale-95');
          
          // Wait for transition to finish
          setTimeout(() => {
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
            sessionStorage.setItem('tsbContactPopupShown', 'true');
          }, 300);
        };

        if (closeBtn) {
          closeBtn.addEventListener('click', closePopup);
        }
        
        // Close if clicked outside the box
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) {
            closePopup();
          }
        });
      }
    }
  });
</script>
