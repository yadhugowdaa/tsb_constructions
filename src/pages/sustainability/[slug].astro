---
import { getCollection, render } from 'astro:content';
import ServiceLayout from '../../layouts/ServiceLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('sustainability');
  return posts.map(entry => {
    const slug = entry.id.replace(/\.[^/.]+$/, ""); 
    return {
      params: { slug }, 
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ServiceLayout 
  title={entry.data.title} 
  subtitle="Sustainability & Us"
  bgImage={entry.data.coverImage}
>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-20">
      
      <article class="
        prose prose-slate max-w-none
        prose-headings:font-bold prose-headings:text-slate-900
        prose-h1:text-2xl prose-h1:md:text-4xl prose-h1:leading-tight prose-h1:mb-6
        prose-h2:text-xl prose-h2:md:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-orange-600
        prose-h3:text-lg prose-h3:md:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-base prose-p:leading-relaxed prose-p:text-slate-600 prose-p:mb-5
        prose-li:text-slate-600 prose-li:leading-relaxed prose-li:my-1
        prose-ul:my-4 prose-ul:pl-4
        prose-strong:text-slate-800
        prose-blockquote:border-l-4 prose-blockquote:border-orange-400 prose-blockquote:bg-orange-50 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-5 prose-blockquote:not-italic prose-blockquote:text-slate-700
        prose-a:text-orange-600 prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-xl
      ">
          <Content />
      </article>

      {/* GALLERY SECTION */}
      {entry.data.gallery && entry.data.gallery.length > 0 && (
          <div class="border-t border-gray-200 pt-10 mt-10">
              <h3 class="text-2xl font-bold text-slate-900 mb-6">Gallery</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {entry.data.gallery.map((item) => {
                      let imgSrc = typeof item === 'string' ? item : item.image;
                      if (imgSrc.startsWith('public/')) {
                          imgSrc = imgSrc.replace('public/', '/');
                      }
                      return (
                          <div class="rounded-xl overflow-hidden shadow-md hover:shadow-xl transition duration-500">
                              <img src={imgSrc} class="w-full h-64 object-cover" alt="Gallery Image" />
                          </div>
                      );
                  })}
              </div>
          </div>
      )}

      <div class="mt-10 pt-8 border-t border-gray-200">
          <a href="/#sustainability" class="inline-flex items-center gap-2 text-orange-600 font-bold hover:text-orange-700 transition text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              Back to Home
          </a>
      </div>

  </div>
</ServiceLayout>

<style is:global>
  /* Better mobile list styling */
  article.prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  article.prose ul li {
    padding-left: 0.25rem;
  }
  article.prose ul li::marker {
    color: #f97316;
  }
  /* Blockquote em styling */
  article.prose blockquote p {
    font-style: italic;
  }
  article.prose blockquote p:last-child {
    font-style: normal;
    font-weight: 600;
    font-size: 0.875rem;
    color: #64748b;
    margin-top: 0.5rem;
  }
</style>